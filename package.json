{
  "name": "khata",
  "version": "0.1.0",
  "private": true,
  "description": "Khata: split shared expenses with groups and friends, keep private hisabs between two people, and settle up. Runs on Cloudflare Workers and D1.",
  "license": "MIT",
  "author": "Aback Group",
  "homepage": "https://khata.aback.ai",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:copy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply khata --local",
    "db:migrate:remote": "wrangler d1 migrations apply khata --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "bun run check:deploy && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:copy": "bun run scripts/check-dashes.ts",
    "check:deploy": "bun run scripts/check-deploy-config.ts",
    "postinstall": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts > /dev/null"
  },
  "dependencies": {
    "@aback-ui/tokens": "0.2.2",
    "@aback-ui/ui": "0.2.2",
    "@tabler/icons-react": "^3.50.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
